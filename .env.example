API_KEY=replace-with-a-long-random-string
# Public address visitors use. With Apache in front, use that site URL.
PUBLIC_URL=http://localhost:4100
PUBLIC_READ=true
CORS_ORIGIN=*
MAX_UPLOAD_BYTES=209715200
PORT=4100
# Behind Apache, the systemd unit binds to 127.0.0.1. Leave unset for Docker.
# HOST=127.0.0.1
